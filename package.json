{
  "name": "bible-data",
  "module": "index.ts",
  "type": "module",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/inquirer": "^9.0.9"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "scripts": {
    "start": "bun run main.ts",
    "dev": "bun run --watch main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "download:protestant": "bun run src/protestant/download-all.ts",
    "download:catholic": "bun run src/catholic/download-all.ts",
    "download:all": "bun run download:protestant && bun run download:catholic"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.3.0",
    "cheerio": "^1.2.0",
    "inquirer": "^13.3.0"
  }
}

